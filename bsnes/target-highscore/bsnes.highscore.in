[Highscore]
Name=bsnes
Version=@version@
Commit=@commit@
Module=bsnes-highscore.so
Authors=byuu et all;
Website=https://github.com/bsnes-emu/bsnes/
SourceCode=https://github.com/highscore-emu/bsnes/
Issues=https://github.com/highscore-emu/bsnes/issues
LicensePath=LICENSE.txt
Platforms=SuperNintendoEntertainmentSystem;SuperGameBoy;

[Firmware:SuperGameBoy]
sgb-rom=required
sgb2-rom=required

[Environment]
# Otherwise OpenMP will busywait, see https://github.com/bsnes-emu/bsnes/issues/254
OMP_WAIT_POLICY=passive
